# Roomly — vision API keys (either works; OpenAI is preferred if both are set).
# Without a key the app runs in demo mode: it guesses objects from stroke shapes locally.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Optional: override the vision model (default: gpt-4o-mini)
# OPENAI_VISION_MODEL=gpt-4o

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the vision model (default: gemini-2.0-flash)
# GEMINI_VISION_MODEL=gemini-2.0-flash
