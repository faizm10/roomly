{
  "manifest_version": 3,
  "name": "Playground",
  "version": "1.0.0",
  "description": "Transform websites into playful, living worlds with animated pets and characters.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.github.com/*",
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.github.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "js/themes.js",
        "js/animal.js",
        "js/playground.js",
        "js/layouts/linkedin-swipe.js",
        "content.js"
      ],
      "css": ["styles.css", "css/linkedin-swipe.css"],
      "run_at": "document_idle"
    }
  ]
}
